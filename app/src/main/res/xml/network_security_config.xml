<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Room directory has no HTTPS reverse proxy yet. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">175.178.174.103</domain>
        <!-- guanfu.txt still lists some mods as http://www.boonix.art/... -->
        <domain includeSubdomains="true">boonix.art</domain>
        <!-- Mojang skin CDN historically returns http://textures.minecraft.net/... -->
        <domain includeSubdomains="true">textures.minecraft.net</domain>
        <domain includeSubdomains="true">minecraft.net</domain>
        <!-- Local authlib-injector / offline Yggdrasil for vanilla skins -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
