<?xml version="1.0" encoding="utf-8"?>
<!-- Soft ambient orbs (PC GlassOrb*) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="280dp"
        android:height="280dp"
        android:gravity="top|start"
        android:left="-40dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="#553282B8" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="top|end"
        android:right="-30dp"
        android:top="20dp">
        <shape android:shape="oval">
            <solid android:color="#406366F1" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:bottom="-40dp"
        android:gravity="bottom|start"
        android:left="40dp">
        <shape android:shape="oval">
            <solid android:color="#3314B8A6" />
        </shape>
    </item>
    <item
        android:width="200dp"
        android:height="200dp"
        android:bottom="10dp"
        android:gravity="bottom|end"
        android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#28EC4899" />
        </shape>
    </item>
</layer-list>
