<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textUiPluginName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/booxin_navy"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="欢迎语插件" />

    <TextView
        android:id="@+id/textUiPluginDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/md_theme_light_outline"
        android:textSize="12sp"
        tools:text="UI 插件 · 已启用 · v1.0.0" />

    <TextView
        android:id="@+id/textUiPluginDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/booxin_navy"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="按时段显示问候语"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUiPluginToggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/plugins_action_disable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUiPluginDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/plugins_action_uninstall" />
    </LinearLayout>
</LinearLayout>
