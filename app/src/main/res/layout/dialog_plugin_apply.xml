<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plugin_store_apply_action"
        android:textColor="@color/booxin_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textApplyStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/plugin_store_apply_step1"
        android:textColor="@color/md_theme_light_outline"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textApplyLoginHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/plugin_store_apply_hint"
        android:textColor="@color/md_theme_light_outline"
        android:textSize="12sp" />

    <!-- Step 1: 基本信息 -->
    <ScrollView
        android:id="@+id/panelApplyStep1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/plugin_store_field_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPluginName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/plugin_store_field_type"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerApplyType"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/plugin_store_field_desc">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPluginDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Step 2: 上传文件 / 外链 -->
    <LinearLayout
        android:id="@+id/panelApplyStep2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plugin_store_upload_hint"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textPickedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/plugin_store_no_file"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPickFile"
            style="@style/Widget.Booxin.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/plugin_store_pick_file" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/plugin_store_field_url_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPluginUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApplyCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApplyBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plugin_store_apply_back"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApplyNext"
            style="@style/Widget.Booxin.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plugin_store_apply_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubmitApply"
            style="@style/Widget.Booxin.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plugin_store_upload_submit"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
