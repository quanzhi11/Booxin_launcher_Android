<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textBtDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/booxin_navy"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Xbox Wireless Controller" />

        <TextView
            android:id="@+id/textBtDeviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp"
            tools:text="手柄 · AA:BB:CC:DD:EE:FF" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonBtDisconnect"
        style="@style/Widget.Booxin.SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/bt_disconnect"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonBtAction"
        style="@style/Widget.Booxin.PrimaryButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="72dp"
        android:text="@string/bt_pair"
        android:textSize="13sp" />
</LinearLayout>
