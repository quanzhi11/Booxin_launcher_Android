<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plugin_store_oversize_title"
        android:textColor="@color/booxin_navy"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/plugin_store_oversize_hint"
        android:textColor="@color/md_theme_light_outline"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/imageQqQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/plugin_store_qq_qr"
        android:scaleType="fitCenter"
        android:src="@drawable/qq_contact_plugin_upload" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/plugin_store_qq_info"
        android:textColor="@color/booxin_navy"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
