<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface_card"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textVersionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/booxin_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="1.21.4" />

        <TextView
            android:id="@+id/textVersionMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="13sp"
            tools:text="正式版 · 未安装" />
    </LinearLayout>

    <TextView
        android:id="@+id/textVersionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_brand_hero"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="正式版" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonVersionMore"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="⋮"
        android:textSize="18sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonManageVersion"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:text="@string/version_manage_entry" />
</LinearLayout>
