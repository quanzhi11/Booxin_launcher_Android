<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/panelSkinCatalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSkins"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_store_skin" />

        <TextView
            android:id="@+id/textSkinEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/skin_store_empty"
            android:textColor="@color/md_theme_light_outline"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panelSkinDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSkinDetailBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/skin_store_back" />

            <TextView
                android:id="@+id/textSkinDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/booxin_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="皮肤名" />
        </LinearLayout>

        <!-- Left ~1/3 preview+actions · Right ~2/3 comments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/panelSkinDetailOverview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <android.webkit.WebView
                        android:id="@+id/webSkinPreview3d"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/textSkinDetailMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/md_theme_light_outline"
                        android:textSize="11sp"
                        tools:text="作者 · classic · v1.0.0" />

                <TextView
                    android:id="@+id/textSkinDetailOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/booxin_navy"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="原创 · 允许转载"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textSkinDetailReprintBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_skin_reprint_circle"
                    android:gravity="center"
                    android:text="@string/skin_store_origin_reprint"
                    android:textColor="#FFFFC107"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textSkinDetailSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/md_theme_light_outline"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="来源：…"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textSkinDetailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/booxin_navy"
                        android:textSize="12sp"
                        tools:text="简介" />

                    <TextView
                        android:id="@+id/textSkinDetailRating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/md_theme_light_outline"
                        android:textSize="12sp"
                        tools:text="★ 4.5" />

                    <RatingBar
                        android:id="@+id/ratingBarSkinMine"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:isIndicator="false"
                        android:numStars="5"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/textSkinRateHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/skin_store_need_login"
                        android:textColor="@color/md_theme_light_outline"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkinApply"
                        style="@style/Widget.Booxin.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/skin_store_apply" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkinReport"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/skin_store_report_skin" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/skin_store_apply_hint"
                        android:textColor="@color/md_theme_light_outline"
                        android:textSize="11sp" />

                    <!-- Kept for binding compatibility; tabs no longer used. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkinPageRating"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkinPageComments"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="@color/md_theme_light_outline" />

            <LinearLayout
                android:id="@+id/panelSkinDetailComments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/skin_store_page_comments"
                        android:textColor="@color/booxin_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonWriteSkinComment"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="32dp"
                        android:text="@string/skin_store_comment_write"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelSkinCommentComposer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/skin_store_comment_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputSkinComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCancelSkinComment"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/skin_store_comment_cancel" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSubmitSkinComment"
                            style="@style/Widget.Booxin.PrimaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/skin_store_comment_submit" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textSkinCommentsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/skin_store_comments_empty"
                    android:textColor="@color/md_theme_light_outline"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSkinComments"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/panelSkinUpload"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:clickable="true"
        android:elevation="8dp"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSkinUploadBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/skin_store_back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_store_upload_title"
                android:textColor="@color/booxin_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/skin_store_field_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputSkinName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/skin_store_field_desc">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputSkinDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/skin_store_origin_label"
                android:textColor="@color/booxin_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleSkinOrigin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonOriginOriginal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/skin_store_origin_original" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonOriginReprint"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/skin_store_origin_reprint" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSkinSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/skin_store_field_source"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputSkinSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSkinAllowReprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/skin_store_allow_reprint" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleSkinModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModelClassic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/accounts_skin_model_classic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModelSlim"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/accounts_skin_model_slim" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickSkinFile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/skin_store_pick_file" />

            <TextView
                android:id="@+id/textSkinPickedFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/skin_store_no_file"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSubmitSkinUpload"
                style="@style/Widget.Booxin.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/skin_store_submit" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
