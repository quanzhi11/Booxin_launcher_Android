<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ingame_mp_room_name_label"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/ingame_mp_room_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputRoomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="64"
                android:maxLines="1"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ingame_mp_room_name_help"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ingame_mp_room_remark_label"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/ingame_mp_room_remark_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputRoomRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLength="128"
                android:maxLines="3"
                android:minLines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ingame_mp_room_remark_help"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ingame_mp_deps_section_title"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ingame_mp_deps_section_help"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/panelHostDeps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_surface_inset"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/textDepsGameVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ingame_mp_deps_scanning"
                android:textColor="@color/booxin_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDepsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textDepsMods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="8"
                android:scrollbars="vertical"
                android:textColor="@color/booxin_navy"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textDepsVanilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ingame_mp_deps_vanilla"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ingame_mp_modpack_label"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ingame_mp_modpack_help"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="11sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/ingame_mp_modpack_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputModpackUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ingame_mp_port_title"
            android:textColor="@color/booxin_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/ingame_mp_port_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:text="25565"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/groupPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPrivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/ingame_mp_private_room"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioPublic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ingame_mp_public_room"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/ingame_mp_privacy_help"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
