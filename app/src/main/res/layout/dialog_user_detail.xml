<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-height shell so the right NestedScrollView can scroll on phone landscape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootUserDetail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Left: avatar / name / title / gold -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_weight="0.38"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/imageAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/multiplayer_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder" />

            <ImageView
                android:id="@+id/imageFrame"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/multiplayer_avatar_frame"
                android:scaleType="fitXY"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/textUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/booxin_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="friend001" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#C9A227"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="LV2 · 挖矿高手" />

        <TextView
            android:id="@+id/textGold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#E8C547"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="120 金币" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="2dp"
        android:background="#332F6BFF" />

    <!-- Right: scrollable status + actions -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollUserDetail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.62"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="10dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/booxin_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="在线" />

            <TextView
                android:id="@+id/textSignature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp"
                tools:text="这个人很懒，还没有写签名" />

            <TextView
                android:id="@+id/badgeRelationship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_relationship_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/booxin_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="闺蜜"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textBlockedHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#E08A3C"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="对方已将您拉黑"
                tools:visibility="visible" />

            <!-- Friend 2×2 without GridLayout (avoids same-cell / weight measure crashes). -->
            <LinearLayout
                android:id="@+id/gridFriendActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonChat"
                        style="@style/Widget.Booxin.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/multiplayer_user_detail_chat"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRelationship"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/multiplayer_user_detail_relationship"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBlockFriend"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/multiplayer_user_detail_block"
                        android:textColor="#D94A4A"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonUnblockFriend"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/multiplayer_unblock"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRemoveFriend"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/multiplayer_remove_friend"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStrangerAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/multiplayer_user_detail_block"
                android:textColor="#D94A4A"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
