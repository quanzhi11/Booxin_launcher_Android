<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accounts_skin_hint"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface_card"
            android:padding="10dp"
            android:text="@string/accounts_skin_uuid_note"
            android:textColor="#B8860B"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/imageSkinPreview"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/accounts_skin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder" />

        <TextView
            android:id="@+id/textSkinPreviewCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp"
            tools:text="随机 · Steve" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/accounts_skin_strategy"
            android:textColor="@color/booxin_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupSkinMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/radioSkinRandom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounts_skin_mode_random" />

            <RadioButton
                android:id="@+id/radioSkinSteve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounts_skin_mode_steve" />

            <RadioButton
                android:id="@+id/radioSkinAlex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounts_skin_mode_alex" />

            <RadioButton
                android:id="@+id/radioSkinPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounts_skin_mode_player" />

            <RadioButton
                android:id="@+id/radioSkinCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounts_skin_mode_custom" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/panelSkinPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/accounts_skin_player_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputSkinPlayerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="16" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFetchPlayerSkin"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/accounts_skin_fetch_player" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/accounts_skin_player_note"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelSkinCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textCustomSkinPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/accounts_skin_custom_empty"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickCustomSkin"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/accounts_skin_pick_file" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/accounts_skin_model"
                android:textColor="@color/booxin_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupSkinModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioModelClassic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/accounts_skin_model_classic" />

                <RadioButton
                    android:id="@+id/radioModelSlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/accounts_skin_model_slim" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/textSkinStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/accounts_skin_status_pick"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
