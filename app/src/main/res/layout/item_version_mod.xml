<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textModName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/booxin_navy"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="example-mod.jar" />

        <TextView
            android:id="@+id/textModStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp"
            tools:text="已启用" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonToggle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/version_manage_mod_disable" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonUninstall"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/version_manage_mod_uninstall" />
</LinearLayout>
