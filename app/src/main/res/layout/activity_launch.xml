<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220">

    <SurfaceView
        android:id="@+id/surfaceGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      FCL-style stack: TouchPad at bottom receives blank-area touches as mouse.
      Buttons / joystick are siblings on top and only occupy their own bounds.
    -->
    <FrameLayout
        android:id="@+id/panelControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:splitMotionEvents="true"
        android:clipChildren="false">

        <com.booxin.launcher.ui.launch.input.GameTouchPad
            android:id="@+id/touchPad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />

        <ImageView
            android:id="@+id/cursorView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_game_cursor"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:elevation="10dp" />

        <com.booxin.launcher.ui.launch.input.TouchPassthroughLayout
            android:id="@+id/panelCustomButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:splitMotionEvents="true"
            android:clipChildren="false">

            <!-- Joystick inside passthrough so hold-key + move stick + look can coexist -->
            <com.booxin.launcher.ui.launch.input.VirtualJoystick
                android:id="@+id/joystickMove"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="top|start"
                android:elevation="4dp" />
        </com.booxin.launcher.ui.launch.input.TouchPassthroughLayout>

        <!-- FCL TouchCharInput: 1px focus target for system IME -->
        <com.booxin.launcher.ui.launch.input.TouchCharInput
            android:id="@+id/touchCharInput"
            android:layout_width="1px"
            android:layout_height="1px"
            android:background="@android:color/transparent"
            android:ems="10"
            android:imeOptions="flagNoFullscreen|flagNoExtractUi|actionDone"
            android:inputType="text|textMultiLine|textAutoCorrect"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/panelEditBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="10dp"
            android:background="@drawable/bg_edit_bar"
            android:padding="8dp"
            android:scrollbars="none"
            android:visibility="gone"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEditAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_add"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_delete"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditShrink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_shrink"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditGrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_grow"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_reset"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_control_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/control_edit_done"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnFloatingBall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center|end"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_floating_ball"
            android:gravity="center"
            android:text="@string/control_floating_ball"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="6dp" />
    </FrameLayout>

    <!-- Loading cover: stays until Minecraft is actually ready (not black Surface). -->
    <LinearLayout
        android:id="@+id/panelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B1220"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textLaunchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:text="@string/launch_loading_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLaunchMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textLoadingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/launch_loading_percent"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressLaunch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF4FC3F7"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/textLoadingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/launch_loading_status_init"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="#22000000"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#B3FFFFFF"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStop"
                style="@style/Widget.Booxin.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/launch_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClose"
                style="@style/Widget.Booxin.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/launch_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
