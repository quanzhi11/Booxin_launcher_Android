<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/version_manage_title"
                android:textColor="@color/booxin_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textVersionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_light_outline"
                android:textSize="12sp"
                tools:text="1.21.1-forge-xxx" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabManage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_tab_details" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_tab_mods" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_tab_resourcepacks" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:id="@+id/panelDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabManage">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_base_version"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textBaseVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/booxin_navy"
            android:textStyle="bold"
            tools:text="1.21.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_loader_type"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textVersionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/booxin_navy"
            android:textStyle="bold"
            tools:text="Forge/Fabric 等模组版本" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_json_type"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textJsonType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/booxin_navy"
            android:textStyle="bold"
            tools:text="正式版" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_version_path"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textVersionPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/booxin_navy"
            android:textSize="12sp"
            tools:text="/data/data/.../versions/1.21.1-forge-xxx" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_mods_path"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textModsPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/booxin_navy"
            android:textSize="12sp"
            tools:text="/data/data/.../versions/1.21.1-forge-xxx/mods" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_resourcepacks_path"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textResourcePacksPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/booxin_navy"
            android:textSize="12sp"
            tools:text="/data/data/.../versions/1.21.1/resourcepacks" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelMods"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabManage">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDownloadUrl"
            style="@style/Widget.Booxin.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_download_url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textVanillaHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/version_manage_vanilla_no_mods"
            android:textColor="@color/md_theme_light_outline"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonDownloadUrl" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMods"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonDownloadUrl"
            tools:listitem="@layout/item_version_mod" />

        <TextView
            android:id="@+id/textModsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_mods_empty"
            android:textColor="@color/md_theme_light_outline"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recyclerMods"
            app:layout_constraintEnd_toEndOf="@id/recyclerMods"
            app:layout_constraintStart_toStartOf="@id/recyclerMods"
            app:layout_constraintTop_toTopOf="@id/recyclerMods"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelResourcePacks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabManage">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDownloadPackUrl"
            style="@style/Widget.Booxin.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_download_url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResourcePacks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonDownloadPackUrl"
            tools:listitem="@layout/item_version_mod" />

        <TextView
            android:id="@+id/textPacksEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_manage_packs_empty"
            android:textColor="@color/md_theme_light_outline"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recyclerResourcePacks"
            app:layout_constraintEnd_toEndOf="@id/recyclerResourcePacks"
            app:layout_constraintStart_toStartOf="@id/recyclerResourcePacks"
            app:layout_constraintTop_toTopOf="@id/recyclerResourcePacks"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
