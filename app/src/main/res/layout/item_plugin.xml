<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textPluginName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/booxin_navy"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Vulkan Zink" />

    <TextView
        android:id="@+id/textPluginDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/md_theme_light_outline"
        android:textSize="12sp"
        tools:text="渲染器 · 已安装 · builtin" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPluginAction"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/plugins_action_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPluginToggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/plugins_action_disable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPluginUninstall"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/plugins_action_uninstall" />
    </LinearLayout>
</LinearLayout>
