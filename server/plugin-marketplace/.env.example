PORT=5020
PUBLIC_BASE=/plugin-api
PUBLIC_ORIGIN=https://boonix.art/plugin-api

# Local admin password login (recommended for panel).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Comma-separated Booxin user ids: these accounts can also password-login via 联机账号.
ADMIN_USER_IDS=

# Optional: dedicated Booxin account used for developer search when using local admin password.
# If empty, local login will try ADMIN_USERNAME/ADMIN_PASSWORD against Auth.
BOOXIN_AUTH_USERNAME=
BOOXIN_AUTH_PASSWORD=

# Optional shared secret for scripts (X-Admin-Secret). Can equal ADMIN_PASSWORD.
ADMIN_SECRET=change-me-admin-secret

# Same Auth base as Eco / launcher.
BOOXIN_AUTH_API_BASE=https://boonix.art/bbx/api/auth/

# SMTP for reject notification (reuse Auth SMTP credentials on the server).
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Booxin 插件市场

# Optional: comment report AI (same spirit as desktop chat report). If empty, local heuristics are used.
# CHAT_MODERATION_API_KEY=
# CHAT_MODERATION_API_BASE=https://api.openai.com/v1
# CHAT_MODERATION_MODEL=gpt-4o-mini
